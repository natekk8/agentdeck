              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="#121829" BorderBrush="#263350" BorderThickness="1" Padding="3" VerticalAlignment="Top">
              <Grid>
                <Image Name="BrandLogo" Stretch="Uniform" Visibility="Collapsed"/>
                <Viewbox Name="BrandFallback">
                  <Canvas Width="1024" Height="1024">
                    <Path Data="M225.019 348.676C200.248 298.052 247.243 242.046 301.4 257.649L788.018 397.852C833.201 410.87 850.04 466.072 819.816 502.092L555.77 816.77C525.546 852.789 468.258 845.792 447.592 803.556L225.019 348.676Z">
                      <Path.Fill>
                        <RadialGradientBrush MappingMode="RelativeToBoundingBox" GradientOrigin="0.20,0.22" Center="0.30,0.32" RadiusX="0.85" RadiusY="0.85">
                          <GradientStop Color="#81A6F8" Offset="0"/>
                          <GradientStop Color="#10082C" Offset="1"/>
                        </RadialGradientBrush>
                      </Path.Fill>
                    </Path>
                    <Path Data="M377.121 358.488L385.45 375.526L402.488 367.197L410.817 384.234L427.854 375.905L436.183 392.942L453.22 384.614L461.549 401.651L444.512 409.98L452.841 427.017L435.803 435.346L444.132 452.384L427.095 460.713L435.424 477.75L316.162 536.052L299.504 501.978L333.579 485.32L308.592 434.208L274.517 450.865L257.859 416.791L377.121 358.488ZM342.667 417.55L367.654 468.662L401.728 452.004L393.4 434.967L410.437 426.638L402.108 409.6L385.071 417.929L376.742 400.892L342.667 417.55ZM494.887 469.845L544.86 572.069L527.823 580.398L536.152 597.436L399.852 664.067L391.524 647.03L374.486 655.359L324.513 553.134L494.887 469.845ZM408.94 596.297L417.269 613.334L485.419 580.019L477.09 562.981L494.127 554.652L477.47 520.578L375.245 570.551L391.903 604.626L408.94 596.297Z" Fill="White"/>
                  </Canvas>
                </Viewbox>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="AgentDeck" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,7,1"/>
                <Border Background="#182342" BorderBrush="#354C82" BorderThickness="1" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                  <TextBlock Name="VersionBadge" Text="v2.0" FontSize="10" FontWeight="SemiBold" Foreground="#9AB5FF"/>
                </Border>
              </WrapPanel>
              <TextBlock Name="BrandTagline" Text="Remote AI IDE control in your pocket." FontSize="11"
                         Foreground="#7F9EF8" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Bottom Live Stick Status + Battery Card -->
          <Border DockPanel.Dock="Bottom" Background="#0F1524" BorderBrush="#212C46" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,10,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Border Name="SidebarBatteryBadge" DockPanel.Dock="Right" Background="#0B2922" BorderBrush="#195243"
                        BorderThickness="1" CornerRadius="6" Padding="7,2" Visibility="Collapsed">
                  <TextBlock Name="SidebarBatteryText" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Mint}"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Name="LinkDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                  <TextBlock Name="LinkStatus" Text="Connecting..." FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Mint}"/>
                </StackPanel>
              </DockPanel>
              <ProgressBar Name="SidebarBatteryBar" Height="4" Minimum="0" Maximum="100" Value="0"
                           Foreground="#10B981" Background="#1A2236" BorderThickness="0" Margin="0,0,0,7" Visibility="Collapsed"/>
              <TextBlock Name="Context" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Text="Waiting for StickS3"/>
            </StackPanel>
          </Border>

          <!-- Scrollable Navigation -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Button Name="NavHome" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M3,11 L12,3 L21,11 V20 H15 V14 H9 V20 H3 Z" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavHomeText" Text="Home" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavPrompts" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M3,5 H9 L11,7 H21 V19 H3 Z" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavPromptsText" Text="Projects &amp; Prompts" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavSessions" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M4,5 H20 V17 H8 L4,20 Z" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavSessionsText" Text="Sessions" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavAccounts" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 M4,20 C4,16 8,14 12,14 C16,14 20,16 20,20" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavAccountsText" Text="Accounts" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavDevices" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M7,3 H17 V21 H7 Z M10,18 H14" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavDevicesText" Text="Devices" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavWifi" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M2,9 C8,4 16,4 22,9 M5,13 C9,9.5 15,9.5 19,13 M9,17 C11,15.5 13,15.5 15,17 M12,20 L12,20.2" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavWifiText" Text="Wi-Fi" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavRemote" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M2,12 H22 M12,2 C15,6 15,18 12,22" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavRemoteText" Text="Remote Control" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavFeedback" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M4,4 H20 V16 H9 L4,20 Z M12,8 V11 M12,13.5 L12,13.7" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavFeedbackText" Text="Feedback" FontWeight="Medium"/>
                </StackPanel>
              </Button>
              <Button Name="NavSettings" Style="{StaticResource Nav}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 M4,12 L2,12 M22,12 L20,12 M12,4 L12,2 M12,22 L12,20" Width="15" Height="15" Stretch="Uniform" Stroke="#8E9BB3" StrokeThickness="1.7" Margin="0,0,11,0"/>
                  <TextBlock Name="NavSettingsText" Text="Settings" FontWeight="Medium"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Main Content Column -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Top Titlebar with Live Status Pills & 1-Click Auto-OFF -->
        <DockPanel Margin="24,10,14,0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Name="WinMinBtn" Style="{StaticResource ChromeBtn}" ToolTip="Minimize">
              <Path Data="M1,5.5 H10" Width="11" Height="11" Stretch="None" Stroke="#A6B3C9" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button Name="WinMaxBtn" Style="{StaticResource ChromeBtn}" ToolTip="Maximize">
              <Path Name="WinMaxIcon" Data="M1.5,1.5 H9.5 V9.5 H1.5 Z" Width="11" Height="11" Stretch="None" Stroke="#A6B3C9" StrokeThickness="1.4"/>
            </Button>
            <Button Name="WinCloseBtn" Style="{StaticResource ChromeCloseBtn}" ToolTip="Close">
              <Path Data="M1.5,1.5 L9.5,9.5 M9.5,1.5 L1.5,9.5" Width="11" Height="11" Stretch="None" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Name="TitleJobsBtn" Style="{StaticResource PillBtn}" Padding="10,4" MinHeight="26" Margin="0,0,8,0"
                    Background="#101829" BorderBrush="#24314E">
              <StackPanel Orientation="Horizontal">
                <Ellipse Name="TitleJobsDot" Width="7" Height="7" Fill="#8E9BB3" Margin="0,0,7,0"/>
                <TextBlock Name="TitleJobsText" Text="Idle" FontSize="11.5" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Button>
            <Border Name="TitleChainBadge" Background="#1E1838" BorderBrush="#4C3B94" BorderThickness="1" CornerRadius="13"
                    Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock Name="TitleChainText" Text="Chain: 0 queued" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Violet}"/>
            </Border>
            <Button Name="TitleShutdownBtn" Style="{StaticResource PillBtn}" Padding="11,4" MinHeight="26" Margin="0"
                    Background="#101829" BorderBrush="#24314E">
              <StackPanel Orientation="Horizontal">
                <Ellipse Name="TitleShutdownDot" Width="7" Height="7" Fill="#8E9BB3" Margin="0,0,7,0"/>
                <TextBlock Name="TitleShutdownText" Text="Auto-OFF PC: Off" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="24,6,24,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Top Animated Banners -->
          <StackPanel Grid.Row="0">
            <!-- Autonomous Shutdown Armed / Countdown Banner -->
            <Border Name="ShutdownBanner" Visibility="Collapsed" Margin="0,0,0,12" Background="#24190A"
                    BorderBrush="#B47C1A" BorderThickness="1" CornerRadius="14" Padding="15,10">
              <DockPanel>
                <Button Name="CancelShutdownBtn" DockPanel.Dock="Right" Style="{StaticResource DangerBtn}"
                        Padding="14,6" MinHeight="30" FontSize="12" Content="Cancel Shutdown" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Name="ShutdownDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                    <TextBlock Name="ShutdownBannerTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="#FDE68A" Text="Auto-Shutdown armed"/>
                  </StackPanel>
                  <TextBlock Name="ShutdownBannerSub" FontSize="11.5" Foreground="#E5C57D" Margin="16,2,0,0" TextWrapping="Wrap"
                             Text="PC will shut down automatically after all work completes — even if StickS3 disconnects."/>
                  <ProgressBar Name="ShutdownCountdownBar" Height="4" Minimum="0" Maximum="30" Value="30" Margin="16,6,0,0"
                               Foreground="#F59E0B" Background="#3B2A10" BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Auto-Updater Bar -->
            <Border Name="UpdateBanner" Visibility="Collapsed" Margin="0,0,0,12" Background="#101A34"
                    BorderBrush="#3D61C2" BorderThickness="1" CornerRadius="14" Padding="15,10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Name="UpdateActionBtn" Style="{StaticResource PrimaryBtn}" Padding="14,6" MinHeight="30" FontSize="12" Content="Update" Margin="0,0,6,0"/>
                  <Button Name="UpdateDismissBtn" Content="✕" Padding="9,5" MinHeight="30" FontSize="11.5" Background="Transparent" BorderBrush="#283552"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Name="UpdateDot" Width="8" Height="8" Fill="#5B7CFA" Margin="0,0,8,0"/>
                    <TextBlock Name="UpdateBannerTitle" FontSize="13.5" FontWeight="SemiBold" Text="Update available"/>
                  </StackPanel>
                  <TextBlock Name="UpdateBannerSub" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="16,2,0,0" Text="Ready to download"/>
                  <ProgressBar Name="UpdateProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="16,6,0,0"
                               Foreground="#5B7CFA" Background="#1D2742" BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- StickS3 Firmware Update Prompt -->
            <Border Name="StickFwBanner" Visibility="Collapsed" Margin="0,0,0,12" Background="#1A150B"
                    BorderBrush="#B47C1A" BorderThickness="1" CornerRadius="14" Padding="15,10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Name="StickFwUpdateBtn" Style="{StaticResource PrimaryBtn}" Padding="14,6" MinHeight="30" FontSize="12" Content="Update StickS3 Firmware" Margin="0,0,6,0"/>
                  <Button Name="StickFwDismissBtn" Content="✕" Padding="9,5" MinHeight="30" FontSize="11.5" Background="Transparent" BorderBrush="#4E3916"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Name="StickFwDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                    <TextBlock Name="StickFwTitle" FontSize="13.5" FontWeight="SemiBold" Text="StickS3 firmware update required"/>
                  </StackPanel>
                  <TextBlock Name="StickFwSub" FontSize="11.5" Foreground="#E2C07D" Margin="16,2,0,0" TextWrapping="Wrap"
                             Text="Connect your M5Stick S3 via USB-C to update it to v2.0.0."/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- Page Header -->
          <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Name="Heading" FontSize="25" FontWeight="Bold" Text="Home"/>
            <TextBlock Name="SubHeading" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                       Text="Send prompts, stage chains, manage IDEs, and connect StickS3"/>
          </StackPanel>

          <!-- Page Body -->
          <Grid Name="Body" Grid.Row="2">
            <!-- 0. Home Dashboard -->
            <Grid Name="Home">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="376"/>
              </Grid.ColumnDefinitions>

              <!-- Quick Prompt & Chain Launcher Card -->
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Name="HomeQuickTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Quick Prompt &amp; Chain Launcher"/>
                    <TextBlock Name="HomeQuickDesc" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Launch a single task or chain multiple prompts sequentially — works autonomously even if StickS3 turns off."/>
                  </StackPanel>

                  <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="10"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Name="HomeIdeLabel" Style="{StaticResource FieldLabel}" Text="AI IDE"/>
                      <ComboBox Name="HomeProvider"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Name="HomeModelLabel" Style="{StaticResource FieldLabel}" Text="Model"/>
                      <ComboBox Name="HomeModel"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                      <TextBlock Name="HomeEffortLabel" Style="{StaticResource FieldLabel}" Text="Reasoning"/>
                      <ComboBox Name="HomeEffort"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Name="HomeModeLabel" Style="{StaticResource FieldLabel}" Text="Mode"/>
                      <ComboBox Name="HomeMode">
                        <ComboBoxItem Name="HomeModeRead" Content="Read-only (Analysis)" Tag="read"/>
                        <ComboBoxItem Name="HomeModeWrite" Content="Write (Edit files)" Tag="write"/>
                        <ComboBoxItem Name="HomeModePlan" Content="Plan &amp; Execute (Auto)" Tag="plan_execute"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Name="HomeProjectLabel" Style="{StaticResource FieldLabel}" Text="Project"/>
                    <ComboBox Name="HomeProject"/>
                  </StackPanel>

                  <DockPanel Grid.Row="3">
                    <TextBlock Name="HomePromptLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Prompt"/>
                    <TextBox Name="HomePromptText" MaxLength="32000" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                  </DockPanel>

                  <!-- Staged Chain Draft Bar -->
                  <Border Name="HomeChainDraftBar" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0"
                          Background="#14112B" BorderBrush="#413478" BorderThickness="1" CornerRadius="10" Padding="11,8">
                    <DockPanel>
                      <Button Name="HomeClearChainBtn" DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Padding="10,3" MinHeight="24" Content="Clear" Margin="8,0,0,0"/>
                      <TextBlock Name="HomeChainSummary" FontSize="12" Foreground="#C4B5FD" TextWrapping="Wrap" Text="Chain draft: 0 steps"/>
                    </DockPanel>
                  </Border>

                  <!-- Bottom Action Row -->
                  <DockPanel Grid.Row="5" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Name="HomeShutdownLabel" Text="Auto-OFF PC" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                      <CheckBox Name="HomeShutdownToggle" Style="{StaticResource AppleSwitch}"/>
                    </StackPanel>
                    <WrapPanel>
                      <Button Name="HomeSendBtn" Style="{StaticResource PrimaryBtn}" Content="Send Prompt" Margin="0,0,8,0"/>
                      <Button Name="HomeStageChainBtn" Content="+ Add Step to Chain" Margin="0,0,8,0"/>
                      <Button Name="HomeOpenSessionsBtn" Content="Sessions" Margin="0"/>
                    </WrapPanel>
                  </DockPanel>
                </Grid>
              </Border>

              <!-- Right Column: Live Activity Summary + AI IDEs + StickS3 -->
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AI IDEs Card -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <Button Name="RefreshIdeBtn" DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Refresh"/>
                      <TextBlock Name="HomeIdesTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Installed AI IDEs"/>
                    </DockPanel>
                    <TextBlock Name="HomeIdesDesc" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Only installed IDEs appear on StickS3. Install missing CLIs in one click."/>

                    <Border Background="#080B13" BorderBrush="#1F2A42" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Name="AgyIdeBadge" Background="#0B2922" BorderBrush="#195243" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="6,0,0,0">
                            <TextBlock Name="AgyIdeStatus" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Mint}" Text="Checking..."/>
                          </Border>
                          <Button Name="InstallAgyBtn" Style="{StaticResource PrimaryBtn}" Padding="10,4" MinHeight="26" FontSize="11" Margin="8,0,0,0" Content="Install" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Antigravity CLI" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Name="AgyIdeDetail" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="Detecting..."/>
                        </StackPanel>
                      </DockPanel>
                    </Border>

                    <Border Background="#080B13" BorderBrush="#1F2A42" BorderThickness="1" CornerRadius="11" Padding="11">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Name="CodexIdeBadge" Background="#0B2922" BorderBrush="#195243" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="6,0,0,0">
                            <TextBlock Name="CodexIdeStatus" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Mint}" Text="Checking..."/>
                          </Border>
                          <Button Name="InstallCodexBtn" Style="{StaticResource PrimaryBtn}" Padding="10,4" MinHeight="26" FontSize="11" Margin="8,0,0,0" Content="Install" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="ChatGPT Codex" FontWeight="SemiBold" FontSize="13"/>
                          <TextBlock Name="CodexIdeDetail" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="Detecting..."/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- StickS3 Quick Connect Card -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Name="HomeStickTitle" Style="{StaticResource SectionTitle}" Text="StickS3 Connection"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <Ellipse Name="HomeStickDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0"/>
                      <TextBlock Name="HomeStickStatus" FontSize="13" FontWeight="SemiBold" Text="Checking StickS3..."/>
                    </StackPanel>
                    <TextBlock Name="HomeStickDetail" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Connect M5Stick S3 via USB-C to pair or flash the latest firmware."/>
                    <WrapPanel>
                      <Button Name="HomePairUsbBtn" Style="{StaticResource PrimaryBtn}" Content="Pair via USB" Margin="0,0,8,0"/>
                      <Button Name="HomeFlashUsbBtn" Content="Flash Firmware (USB)"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Live Work Status Card -->
                <Border Grid.Row="4" Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <Button Name="HomeGoSessionsBtn" DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Inspect"/>
                      <TextBlock Name="HomeLiveTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Live Bridge Status"/>
                    </DockPanel>
                    <TextBlock Name="HomeLiveSummary" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="No active sessions right now."/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- 1. Projects & Prompts (Custom Drag-and-Drop Order, ZERO Suggested Templates) -->
            <Grid Name="Prompts" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="328"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Name="ProjectsTitle" Style="{StaticResource SectionTitle}" Text="IDE Projects"/>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Name="FilterAll" Style="{StaticResource PillBtn}" Content="All" Margin="0,0,6,0"/>
                      <Button Name="FilterAgy" Style="{StaticResource PillBtn}" Content="Antigravity" Margin="0,0,6,0"/>
                      <Button Name="FilterCodex" Style="{StaticResource PillBtn}" Content="Codex"/>
                    </WrapPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Button Name="NewProjectBtn" Style="{StaticResource PrimaryBtn}" Padding="11,5" MinHeight="30" FontSize="12" Content="+ New Project"/>
                      <Button Name="RenameProjectBtn" Grid.Column="2" Padding="11,5" MinHeight="30" FontSize="12" Content="Rename"/>
                      <Button Name="AddProject" Grid.Column="4" Padding="11,5" MinHeight="30" FontSize="12" Content="Add Folder"/>
                    </Grid>
                  </StackPanel>

                  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button Name="ShowProject" Content="Open on Stick" FontSize="12" Padding="8,6" MinHeight="32"/>
                      <Button Name="UseProject" Grid.Column="2" Content="Sync from Stick" FontSize="12" Padding="8,6" MinHeight="32"/>
                    </Grid>
                    <Button Name="BindProject" Content="Bind Antigravity ID" Margin="0,8,0,0" FontSize="12" Padding="8,6" MinHeight="32"/>
                  </StackPanel>

                  <ListBox Name="ProjectList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ToolTip="{Binding Path}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10" FontWeight="Bold"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="195"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Name="ProjectHeading" Style="{StaticResource SectionTitle}" Margin="0" Text="Select a project"/>
                    <TextBlock Name="ProjectSubPath" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>

                  <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Name="MovePromptUpBtn" Style="{StaticResource PillBtn}" Padding="10,3" MinHeight="26" Content="↑" Margin="0,0,6,0"/>
                      <Button Name="MovePromptDownBtn" Style="{StaticResource PillBtn}" Padding="10,3" MinHeight="26" Content="↓"/>
                    </StackPanel>
                    <TextBlock Name="PromptOrderTitle" Style="{StaticResource FieldLabel}" Margin="0" Text="StickS3 Prompt Order (drag rows or use arrows to reorder)"/>
                  </DockPanel>

                  <ListBox Name="PromptList" Grid.Row="2" AllowDrop="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="⋮⋮" Foreground="#5A6B8C" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Cursor="SizeAll"/>
                          <Border Grid.Column="1" Background="#162038" BorderBrush="#283A63" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="0,0,9,0" VerticalAlignment="Center" Visibility="{Binding ActionVisibility}">
                            <TextBlock Text="{Binding ActionLabel}" Foreground="#9AB5FF" FontSize="10.5" FontWeight="Bold"/>
                          </Border>
                          <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="3" Background="{Binding BadgeBg}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10.5" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <DockPanel Grid.Row="3" Margin="0,12,0,6">
                    <ComboBox Name="Provider" DockPanel.Dock="Right" Width="168">
                      <ComboBoxItem Name="ProviderBoth" Content="Both IDEs" Tag=""/>
                      <ComboBoxItem Name="ProviderCodex" Content="Codex" Tag="codex"/>
                      <ComboBoxItem Name="ProviderAgy" Content="Antigravity" Tag="agy"/>
                    </ComboBox>
                    <TextBlock Name="PromptTitleLabel" Style="{StaticResource FieldLabel}" Margin="0" Text="Prompt Name"/>
                  </DockPanel>

                  <TextBox Name="PromptTitle" Grid.Row="4" MaxLength="64" Margin="0,0,0,8" AutomationProperties.Name="Prompt Name"/>

                  <StackPanel Grid.Row="5" Margin="0,0,0,8">
                    <TextBlock Name="PromptDescLabel" Style="{StaticResource FieldLabel}" Text="Short description (what this prompt does)"/>
                    <TextBox Name="PromptDescription" MaxLength="160" AutomationProperties.Name="Prompt Description"/>
                  </StackPanel>

                  <TextBox Name="PromptText" Grid.Row="6" MaxLength="32000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                           VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt Content"/>

                  <DockPanel Grid.Row="7" Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Left">
                      <Button Name="SavePrompt" Style="{StaticResource PrimaryBtn}" Content="Save Prompt" Margin="0,0,8,0"/>
                      <Button Name="NewPrompt" Content="Clear / New" Margin="0,0,8,0"/>
                      <Button Name="DeletePrompt" Style="{StaticResource DangerBtn}" Content="Delete"/>
                    </WrapPanel>
                    <TextBlock Name="GlobalPromptHint" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Text=""/>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- 2. Sessions & Live Agent Monitor -->
            <Grid Name="Sessions" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Left: Session History & Chain Queue -->
              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Name="SessionsTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Sessions"/>
                  </DockPanel>
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="DeleteSessionBtn" Style="{StaticResource DangerBtn}" Content="Delete" IsEnabled="False" FontSize="12" Padding="8,6" MinHeight="32"/>
                    <Button Name="ClearSessionsBtn" Grid.Column="2" Content="Clear Finished" FontSize="12" Padding="8,6" MinHeight="32"/>
                  </Grid>
                  <ListBox Name="SessionList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10.5" FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- Right: Session Inspector + Live Activity Stream -->
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <DockPanel Margin="0,0,0,8">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Name="SessionPhaseBadge" Background="#162140" BorderBrush="#354D91" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,6,0" Visibility="Collapsed">
                          <TextBlock Name="SessionPhaseText" FontSize="11" FontWeight="SemiBold" Foreground="#9AB5FF" Text="Thinking"/>
                        </Border>
                        <Border Name="SessionChainBadge" Background="#1E1838" BorderBrush="#4C3B94" BorderThickness="1" CornerRadius="7" Padding="9,3" Visibility="Collapsed">
                          <TextBlock Name="SessionChainText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Violet}" Text="Chain 1/2"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Name="SessionDetailTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Session Inspector"/>
                    </DockPanel>

                    <TextBlock Name="SessionLocation" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Select a session to inspect live tools, subagents, commands, and output."/>

                    <WrapPanel Margin="0,0,0,10">
                      <Button Name="StopSessionBtn" Style="{StaticResource DangerBtn}" Content="Stop" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" IsEnabled="False"/>
                      <Button Name="RetrySessionBtn" Content="Retry" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" IsEnabled="False"/>
                      <Button Name="ChainNextBtn" Style="{StaticResource PrimaryBtn}" Content="+ Chain Next" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" IsEnabled="False"/>
                      <Button Name="SessionAutoOffBtn" Style="{StaticResource WarningBtn}" Content="Auto-OFF PC" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6"/>
                      <Button Name="CancelChainBtn" Style="{StaticResource DangerBtn}" Content="Cancel Chain" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" Visibility="Collapsed"/>
                      <Button Name="OpenConversation" Style="{StaticResource PrimaryBtn}" Content="Open in Antigravity CLI" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" IsEnabled="False"/>
                      <Button Name="OpenAnswer" Content="Open Output File" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,8,6" IsEnabled="False"/>
                      <Button Name="CopyOutputBtn" Content="Copy Output" Padding="12,5" MinHeight="30" FontSize="12" Margin="0,0,0,6" IsEnabled="False"/>
                    </WrapPanel>

                    <Border Name="QuestionPanel" Background="#112138" BorderBrush="#2C5282" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,10" Visibility="Collapsed">
                      <StackPanel>
                        <TextBlock Name="QuestionHeader" FontWeight="Bold" Foreground="{StaticResource Mint}" FontSize="12.5"/>
                        <TextBlock Name="QuestionText" TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,4,0,10"/>
                        <WrapPanel Name="QuestionOptions"/>
                      </StackPanel>
                    </Border>

                    <!-- Tab Switcher: Output vs Live Activity -->
                    <StackPanel Orientation="Horizontal">
                      <Button Name="TabOutputBtn" Style="{StaticResource PillBtn}" Content="Output" Margin="0,0,8,0"/>
                      <Button Name="TabActivityBtn" Style="{StaticResource PillBtn}" Content="Live Activity (0)"/>
                    </StackPanel>
                  </StackPanel>

                  <Grid>
                    <TextBox Name="SessionAnswer" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                             AutomationProperties.Name="Session Output"/>
                    <ListBox Name="ActivityFeedList" Visibility="Collapsed">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding BadgeBg}" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12.5"/>
                              <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ActionLabel}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </DockPanel>
              </Border>
            </Grid>

            <!-- 3. Accounts -->
            <Grid Name="Accounts" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <DockPanel Margin="0,0,0,8">
                      <Border Name="CodexActiveBadge" DockPanel.Dock="Right" Background="#0B2922" BorderBrush="#195243" BorderThickness="1" CornerRadius="8" Padding="9,4">
                        <TextBlock Name="CodexActiveText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Mint}" Text="Checking..."/>
                      </Border>
                      <TextBlock Name="CodexAccountsTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Codex Accounts"/>
                    </DockPanel>
                    <TextBlock Name="CodexAccountsDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Your active Codex login is detected and saved automatically. Add more accounts below and switch in one click from PC or StickS3."/>
                  </StackPanel>

                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button Name="LoginCodexAccount" Style="{StaticResource PrimaryBtn}" Content="+ Add Codex Account" Margin="0,0,8,0"/>
                    <Button Name="RefreshAccountsBtn" Content="Refresh"/>
                  </WrapPanel>

                  <ListBox Name="CodexAccountList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="6" Padding="8,3" Margin="8,0,6,0"
                                  VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10.5" FontWeight="Bold"/>
                          </Border>
                          <Button Grid.Column="1" Tag="switch" CommandParameter="{Binding Id}" Content="{Binding ActionLabel}"
                                  Margin="8,0,6,0" Padding="11,5" MinHeight="28" FontSize="12" Visibility="{Binding ActionVisibility}"
                                  Background="#1B2848" BorderBrush="#4162B5"/>
                          <Button Grid.Column="2" Tag="delete" CommandParameter="{Binding Id}" Content="✕"
                                  Margin="0" Padding="9,4" MinHeight="28" FontSize="11.5" Background="#25121B" BorderBrush="#541D32" Foreground="#FDA4AF"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <DockPanel Margin="0,0,0,8">
                      <Border Name="AgyActiveBadge" DockPanel.Dock="Right" Background="#10223D" BorderBrush="#264C84" BorderThickness="1" CornerRadius="8" Padding="9,4">
                        <TextBlock Name="AgyActiveText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Blue}" Text="Checking..."/>
                      </Border>
                      <TextBlock Name="AgyAccountsTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Antigravity Account"/>
                    </DockPanel>
                    <TextBlock Name="AgyAccountsDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Antigravity uses your Google account directly inside Antigravity. Active plan tier and weekly AI quotas are synced below."/>

                    <Border Name="AgySubCard" Background="#080B13" BorderBrush="#212D48" BorderThickness="1" CornerRadius="13" Padding="14">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <Border Name="AgyPlanBadge" DockPanel.Dock="Left" Background="#17244A" BorderBrush="#4D75E3" BorderThickness="1" CornerRadius="7" Padding="9,3">
                            <TextBlock Name="AgyPlanText" FontSize="11" FontWeight="Bold" Foreground="#9AB5FF" Text="PRO PLAN"/>
                          </Border>
                          <TextBlock Name="AgyCreditsText" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12"
                                     FontWeight="SemiBold" Foreground="{StaticResource Mint}" Text="0 credits"/>
                        </DockPanel>
                        <TextBlock Name="AgyQuotaText" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                   Text="Checking quota..."/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button Name="RefreshAgyBtn" Style="{StaticResource PrimaryBtn}" Content="Refresh Subscription"/>
                  </WrapPanel>

                  <ListBox Name="AgyAccountList">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                          </StackPanel>
                          <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="10.5" FontWeight="Bold"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>

            <!-- 4. Devices -->
            <Border Name="Devices" Style="{StaticResource Card}" Visibility="Collapsed">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Name="DevicesTitle" Style="{StaticResource SectionTitle}" Text="Paired &amp; Connected Devices"/>
                <ListBox Name="DeviceList" Grid.Row="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                          <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,14,0,12">
                  <Button Name="ShowCode" Content="Show Code on Stick" Margin="0,0,8,6"/>
                  <Button Name="PairUsb" Style="{StaticResource PrimaryBtn}" Content="Pair via USB" Margin="0,0,8,6"/>
                  <Button Name="FlashStickBtn" Content="Flash Firmware (USB)" Margin="0,0,8,6"/>
                  <Button Name="PairUsbCode" Content="USB with Code" Margin="0,0,8,6"/>
                  <Button Name="FindDevices" Content="Scan LAN" Margin="0,0,8,6"/>
                  <Button Name="ForgetDevice" Style="{StaticResource DangerBtn}" Content="Remove Pairing" Margin="0,0,0,6"/>
                </WrapPanel>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Name="PairCodeLabel" Style="{StaticResource FieldLabel}" Text="Pairing code shown on Stick"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Name="PairCode" MaxLength="24" FontFamily="Consolas"/>
                      <Button Name="PairLan" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="Pair Wi-Fi"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Name="DeviceAddressLabel" Style="{StaticResource FieldLabel}" Text="Stick IP Address (optional)"/>
                    <TextBox Name="DeviceAddress"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- 5. Wi-Fi -->
            <Border Name="Wifi" Style="{StaticResource Card}" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Name="WifiTitle" Style="{StaticResource SectionTitle}" Text="StickS3 Wi-Fi"/>
                  <WrapPanel Margin="0,0,0,8">
                    <ComboBox Name="WifiDevice" Width="300" Margin="0,0,8,0"/>
                    <Button Name="ScanWifi" Style="{StaticResource PrimaryBtn}" Content="Scan Wi-Fi on Stick"/>
                  </WrapPanel>
                  <TextBlock Name="WifiStatus" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <TextBlock Name="NetworkName" Style="{StaticResource FieldLabel}" Text="Select a network from the list"/>
                  <WrapPanel>
                    <PasswordBox Name="WifiPassword" IsEnabled="False" Width="260" Margin="0,0,8,0" AutomationProperties.Name="Wi-Fi Password"/>
                    <Button Name="JoinWifi" Style="{StaticResource PrimaryBtn}" Content="Connect Stick"/>
                  </WrapPanel>
                </StackPanel>
                <ListBox Name="NetworkList"/>
              </DockPanel>
            </Border>

            <!-- 6. Remote Control -->
            <ScrollViewer Name="Remote" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Background="#0B2922" BorderBrush="#195243" BorderThickness="1" CornerRadius="7" Padding="8,3">
                          <TextBlock Name="CodexRcStatus" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Mint}" Text="Checking..."/>
                        </Border>
                        <TextBlock Name="CodexRcTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Codex Remote Control"/>
                      </DockPanel>
                      <TextBlock Name="CodexRcDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                 Text="Enable official Codex Remote Control daemon to send prompts from mobile or StickS3 outside your home network."/>
                      <TextBlock Name="CodexRcDetail" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                      <WrapPanel>
                        <Button Name="CodexRcStart" Style="{StaticResource PrimaryBtn}" Content="Start Daemon" Margin="0,0,8,0"/>
                        <Button Name="CodexRcPair" Content="Pairing Code" Margin="0,0,8,0"/>
                        <Button Name="CodexRcStop" Style="{StaticResource DangerBtn}" Content="Stop"/>
                      </WrapPanel>
                      <TextBox Name="CodexRcOutput" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Background="#10223D" BorderBrush="#264C84" BorderThickness="1" CornerRadius="7" Padding="8,3">
                          <TextBlock Name="AgyRcStatus" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Blue}" Text="Checking..."/>
                        </Border>
                        <TextBlock Name="AgyRcTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="Antigravity Remote Control"/>
                      </DockPanel>
                      <TextBlock Name="AgyRcDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                 Text="Manage the Antigravity remote-control background daemon so your PC appears in mobile and remote sessions."/>
                      <TextBlock Name="AgyRcDetail" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                      <TextBlock Name="AgyRcNameLabel" Style="{StaticResource FieldLabel}" Text="Instance name (optional)"/>
                      <TextBox Name="AgyRcName" MaxLength="48" Margin="0,0,0,12"/>
                      <WrapPanel>
                        <Button Name="AgyRcStart" Style="{StaticResource PrimaryBtn}" Content="Start Daemon" Margin="0,0,8,0"/>
                        <Button Name="AgyRcStop" Style="{StaticResource DangerBtn}" Content="Stop" Margin="0,0,8,0"/>
                        <Button Name="RefreshRemoteBtn" Content="Refresh"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <Border DockPanel.Dock="Right" Background="#141B2D" BorderBrush="{StaticResource LineBright}" BorderThickness="1" CornerRadius="7" Padding="8,3">
                        <TextBlock Name="LocalRelayStatus" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Text="Local relay stopped"/>
                      </Border>
                      <TextBlock Name="RelayTitle" Style="{StaticResource SectionTitle}" Margin="0" Text="StickS3 Away-From-Home Encrypted Relay"/>
                    </DockPanel>
                    <TextBlock Name="RelayDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Connects your StickS3 over any hotspot to your home PC using end-to-end AES-256-GCM + HMAC encryption. Run the built-in relay behind a tunnel or reverse proxy."/>
                    <WrapPanel Margin="0,0,0,12">
                      <Button Name="StartLocalRelay" Style="{StaticResource PrimaryBtn}" Content="Start Built-In Relay (8793)" Margin="0,0,8,0"/>
                      <Button Name="StopLocalRelay" Content="Stop Built-In Relay"/>
                    </WrapPanel>
                    <TextBlock Name="RelayAddressLabel" Style="{StaticResource FieldLabel}" Text="Relay Endpoint URL (http://...)"/>
                    <TextBox Name="RelayAddress" MaxLength="180" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button Name="SaveRelay" Style="{StaticResource PrimaryBtn}" Content="Save URL" Margin="0,0,8,6"/>
                      <Button Name="SyncRelay" Content="Push URL to Stick" Margin="0,0,8,6"/>
                      <Button Name="TestRelay" Content="Test Connection" Margin="0,0,8,6"/>
                      <Button Name="ExportChannels" Content="Export Channel Keys" Margin="0,0,8,6"/>
                      <Button Name="ClearRelay" Style="{StaticResource DangerBtn}" Content="Clear URL" Margin="0,0,0,6"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 7. Settings -->
            <ScrollViewer Name="Settings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Name="AutostartStateText" Text="Disabled" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,12,0"/>
                      <CheckBox Name="AutostartToggle" Style="{StaticResource AppleSwitch}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Name="SettingsAutostartTitle" Style="{StaticResource SectionTitle}" Text="Background Autostart &amp; Wake on LAN"/>
                      <TextBlock Name="SettingsAutostartDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                 Text="Start the silent AgentDeck bridge automatically when Windows signs in (zero CMD window) so Wake on LAN and StickS3 prompts are always ready."/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Name="SettingsLangTitle" Style="{StaticResource SectionTitle}" Text="Language"/>
                    <TextBlock Name="SettingsLangDesc" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="English is enabled by default. Changes apply to Windows and automatically sync to a connected StickS3."/>
                    <WrapPanel>
                      <ComboBox Name="LanguagePicker" Width="240" Margin="0,0,10,0">
                        <ComboBoxItem Content="English (Default)" Tag="en"/>
                        <ComboBoxItem Content="Polski" Tag="pl"/>
                      </ComboBox>
                      <Button Name="SaveLanguageBtn" Style="{StaticResource PrimaryBtn}" Content="Apply Language"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Name="SettingsProjectsTitle" Style="{StaticResource SectionTitle}" Text="New Projects Directory"/>
                    <TextBlock Name="SettingsProjectsDesc" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="New random-named projects created from StickS3 (e.g. solar-star) or Windows are created inside this directory."/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Name="ProjectsRootInput"/>
                      <Button Name="BrowseProjectsRoot" Grid.Column="2" Content="Browse..."/>
                      <Button Name="SaveProjectsRoot" Grid.Column="4" Style="{StaticResource PrimaryBtn}" Content="Save Folder"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Name="SettingsAboutTitle" Style="{StaticResource SectionTitle}" Text="Updates, Setup Wizard &amp; Folders"/>
                    <TextBlock Name="SettingsAboutDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="AgentDeck v2.0 · Check GitHub Releases for updates, run the setup wizard, or open local folders."/>
                    <WrapPanel>
                      <Button Name="CheckUpdateBtn" Style="{StaticResource PrimaryBtn}" Content="Check for Updates" Margin="0,0,8,0"/>
                      <Button Name="OpenWizardBtn" Content="Run Setup Wizard" Margin="0,0,8,0"/>
                      <Button Name="OpenDataFolderBtn" Content="Open Data Folder" Margin="0,0,8,0"/>
                      <Button Name="OpenAppFolderBtn" Content="Open App Folder"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- 8. Feedback / Reporter -->
            <Border Name="Feedback" Style="{StaticResource Card}" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Name="FeedbackTitle" Style="{StaticResource SectionTitle}" Text="Send Bug Report or Feature Request"/>
                  <TextBlock Name="FeedbackDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Text="Submit a Bug Report, Feature Request, or general feedback directly to GitHub (github.com/natekk8/agentdeck)."/>
                  <TextBlock Name="FeedbackKindLabel" Style="{StaticResource FieldLabel}" Text="Category"/>
                  <WrapPanel Margin="0,0,0,10">
                    <Button Name="ReportCatBug" Style="{StaticResource PillBtn}" Content="Bug Report" Margin="0,0,8,0"/>
                    <Button Name="ReportCatFeature" Style="{StaticResource PillBtn}" Content="Feature Request" Margin="0,0,8,0"/>
                    <Button Name="ReportCatOther" Style="{StaticResource PillBtn}" Content="Other"/>
                  </WrapPanel>
                  <TextBlock Name="ReportTitleLabel" Style="{StaticResource FieldLabel}" Text="Title"/>
                  <TextBox Name="ReportTitle" MaxLength="140" Margin="0,0,0,10"/>
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Name="ReportContactLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Your GitHub @handle or email (optional)"/>
                    <TextBox Name="ReportContact" MaxLength="120"/>
                  </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <DockPanel Margin="0,0,0,10">
                    <CheckBox Name="ReportIncludeLogs" DockPanel.Dock="Right" Style="{StaticResource AppleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Name="ReportLogsLabel" FontWeight="SemiBold" FontSize="13" Text="Attach sanitized diagnostics"/>
                      <TextBlock Name="ReportLogsDesc" FontSize="11.5" Foreground="{StaticResource Muted}" Text="Includes recent bridge error logs with local usernames redacted."/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel>
                    <Button Name="SendReportBtn" Style="{StaticResource PrimaryBtn}" Content="Submit Report" Margin="0,0,10,0"/>
                    <TextBlock Name="ReportStatusText" FontSize="12.5" Foreground="{StaticResource Mint}" VerticalAlignment="Center"/>
                  </WrapPanel>
                </StackPanel>

                <DockPanel>
                  <TextBlock Name="ReportBodyLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Description (steps to reproduce or idea details)"/>
                  <TextBox Name="ReportBody" MinHeight="80" MaxLength="8000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Status Footer -->
          <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Name="Status" Text="Ready" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,170,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Grid Name="ActivitySpinner" Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                </Grid.RenderTransform>
                <Ellipse Width="16" Height="16" Stroke="#233150" StrokeThickness="2"/>
                <Path Data="M8,1 A7,7 0 0,1 15,8" Stroke="#5B7CFA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
              <ProgressBar Name="Activity" Width="120" Height="4"
                           IsIndeterminate="False" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#171E30" BorderThickness="0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- First-Run Onboarding Overlay -->
      <Grid Name="OnboardingOverlay" Grid.ColumnSpan="2" Background="#DC05070C" Visibility="Collapsed">
        <Border Name="OnboardingCard" Width="570" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#0D121F" BorderBrush="#283654" BorderThickness="1" CornerRadius="22" Padding="28">
          <StackPanel>
            <DockPanel Margin="0,0,0,18">
              <Border DockPanel.Dock="Right" Background="#162038" BorderBrush="#2D406B" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Top">
                <TextBlock Name="OnbStepBadge" Text="Step 1 of 3" FontSize="11.5" FontWeight="SemiBold" Foreground="#9AB5FF"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48" CornerRadius="13" Background="#141C30" BorderBrush="#283554" BorderThickness="1" Padding="4">
                  <Viewbox>
                    <Canvas Width="1024" Height="1024">
                      <Path Data="M225.019 348.676C200.248 298.052 247.243 242.046 301.4 257.649L788.018 397.852C833.201 410.87 850.04 466.072 819.816 502.092L555.77 816.77C525.546 852.789 468.258 845.792 447.592 803.556L225.019 348.676Z">
                        <Path.Fill>
                          <RadialGradientBrush MappingMode="RelativeToBoundingBox" GradientOrigin="0.20,0.22" Center="0.30,0.32" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#81A6F8" Offset="0"/>
                            <GradientStop Color="#10082C" Offset="1"/>
                          </RadialGradientBrush>
                        </Path.Fill>
                      </Path>
                      <Path Data="M377.121 358.488L385.45 375.526L402.488 367.197L410.817 384.234L427.854 375.905L436.183 392.942L453.22 384.614L461.549 401.651L444.512 409.98L452.841 427.017L435.803 435.346L444.132 452.384L427.095 460.713L435.424 477.75L316.162 536.052L299.504 501.978L333.579 485.32L308.592 434.208L274.517 450.865L257.859 416.791L377.121 358.488ZM342.667 417.55L367.654 468.662L401.728 452.004L393.4 434.967L410.437 426.638L402.108 409.6L385.071 417.929L376.742 400.892L342.667 417.55ZM494.887 469.845L544.86 572.069L527.823 580.398L536.152 597.436L399.852 664.067L391.524 647.03L374.486 655.359L324.513 553.134L494.887 469.845ZM408.94 596.297L417.269 613.334L485.419 580.019L477.09 562.981L494.127 554.652L477.47 520.578L375.245 570.551L391.903 604.626L408.94 596.297Z" Fill="White"/>
                    </Canvas>
                  </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="AgentDeck (v2.0)" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                  <TextBlock Name="OnbTagline" Text="Remote AI IDE control in your pocket." FontSize="12" Foreground="#7F9EF8" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>

            <TextBlock Name="OnbStepTitle" FontSize="22" FontWeight="Bold" Text="Welcome to AgentDeck" Margin="0,0,0,4"/>
            <TextBlock Name="OnbStepSub" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"
                       Text="Choose your preferred language for AgentDeck on Windows and StickS3."/>

            <!-- Step 1: Language -->
            <StackPanel Name="OnbStep1" Margin="0,0,0,22">
              <TextBlock Name="OnbLangPrompt" Style="{StaticResource FieldLabel}" Text="Interface Language" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Name="OnbLangEnBtn" Padding="16,14" HorizontalContentAlignment="Left">
                  <StackPanel>
                    <TextBlock Name="OnbLangEnTitle" Text="English" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Name="OnbLangEnSub" Text="Default interface language" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Button>
                <Button Name="OnbLangPlBtn" Grid.Column="2" Padding="16,14" HorizontalContentAlignment="Left">
                  <StackPanel>
                    <TextBlock Name="OnbLangPlTitle" Text="Polski" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Name="OnbLangPlSub" Text="Polski interfejs na PC i Sticku" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <!-- Step 2: Autostart & Wake on LAN -->
            <StackPanel Name="OnbStep2" Visibility="Collapsed" Margin="0,0,0,22">
              <Border Background="#080B13" BorderBrush="#26334E" BorderThickness="1" CornerRadius="14" Padding="18">
                <DockPanel>
                  <CheckBox Name="OnbAutoToggle" DockPanel.Dock="Right" Style="{StaticResource AppleSwitch}" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
                  <StackPanel>
                    <TextBlock Name="OnbAutoTitle" Text="Start AgentDeck with Windows" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Name="OnbAutoDesc" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Keeps the silent bridge active in the background (with zero CMD windows) so Wake on LAN and mobile StickS3 prompts work automatically after boot."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <TextBlock Name="OnbAutoHint" FontSize="11.5" Foreground="#7F9EF8" Margin="4,10,4,0" TextWrapping="Wrap"
                         Text="Recommended: allows StickS3 to connect instantly whenever your PC wakes via Wake on LAN."/>
            </StackPanel>

            <!-- Step 3: StickS3 Pairing -->
            <StackPanel Name="OnbStep3" Visibility="Collapsed" Margin="0,0,0,22">
              <Border Background="#080B13" BorderBrush="#26334E" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse Name="OnbStickDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,9,0"/>
                    <TextBlock Name="OnbStickState" Text="Checking USB connection..." FontSize="14.5" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock Name="OnbStickDetail" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                             Text="Plug your M5Stick S3 into USB-C to pair or flash the latest AgentDeck firmware in one click, or skip and do it anytime in Devices."/>
                  <WrapPanel>
                    <Button Name="OnbPairUsbBtn" Style="{StaticResource PrimaryBtn}" Content="Pair StickS3 via USB" Margin="0,0,8,0"/>
                    <Button Name="OnbFlashUsbBtn" Content="Flash Latest Firmware (USB)"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <DockPanel>
              <Button Name="OnbSkipBtn" DockPanel.Dock="Left" Content="Skip Setup" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="OnbBackBtn" Content="Back" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button Name="OnbNextBtn" Style="{StaticResource PrimaryBtn}" Content="Continue"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- After-Update What's New Overlay -->
      <Grid Name="AfterUpdateOverlay" Grid.ColumnSpan="2" Background="#DC05070C" Visibility="Collapsed">
        <Border Name="AfterUpdateCard" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#0D121F" BorderBrush="#314773" BorderThickness="1" CornerRadius="22" Padding="28">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right" Background="#0B2922" BorderBrush="#195243" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Name="AfterUpdateBadge" Text="v2.0" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Mint}"/>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="#141C30" BorderBrush="#283554" BorderThickness="1" Padding="4">
                  <Viewbox>
                    <Canvas Width="1024" Height="1024">
                      <Path Data="M225.019 348.676C200.248 298.052 247.243 242.046 301.4 257.649L788.018 397.852C833.201 410.87 850.04 466.072 819.816 502.092L555.77 816.77C525.546 852.789 468.258 845.792 447.592 803.556L225.019 348.676Z">
                        <Path.Fill>
                          <RadialGradientBrush MappingMode="RelativeToBoundingBox" GradientOrigin="0.20,0.22" Center="0.30,0.32" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#81A6F8" Offset="0"/>
                            <GradientStop Color="#10082C" Offset="1"/>
                          </RadialGradientBrush>
                        </Path.Fill>
                      </Path>
                      <Path Data="M377.121 358.488L385.45 375.526L402.488 367.197L410.817 384.234L427.854 375.905L436.183 392.942L453.22 384.614L461.549 401.651L444.512 409.98L452.841 427.017L435.803 435.346L444.132 452.384L427.095 460.713L435.424 477.75L316.162 536.052L299.504 501.978L333.579 485.32L308.592 434.208L274.517 450.865L257.859 416.791L377.121 358.488ZM342.667 417.55L367.654 468.662L401.728 452.004L393.4 434.967L410.437 426.638L402.108 409.6L385.071 417.929L376.742 400.892L342.667 417.55ZM494.887 469.845L544.86 572.069L527.823 580.398L536.152 597.436L399.852 664.067L391.524 647.03L374.486 655.359L324.513 553.134L494.887 469.845ZM408.94 596.297L417.269 613.334L485.419 580.019L477.09 562.981L494.127 554.652L477.47 520.578L375.245 570.551L391.903 604.626L408.94 596.297Z" Fill="White"/>
                    </Canvas>
                  </Viewbox>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Name="AfterUpdateTitle" FontSize="20" FontWeight="Bold" Text="Updated to AgentDeck v2.0"/>
                  <TextBlock Name="AfterUpdateSub" FontSize="12" Foreground="#7F9EF8" Text="Everything is ready on your PC." Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
            <Border Background="#080B13" BorderBrush="#23304A" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
              <TextBlock Name="AfterUpdateNotes" FontSize="13" Foreground="#D4DCEB" TextWrapping="Wrap" LineHeight="20"
                         Text="• Obsidian Glass Studio redesign with custom prompt ordering (drag &amp; drop)&#10;• Sequential Prompt Chains &amp; autonomous Auto-Shutdown PC even if Stick disconnects&#10;• Deep Antigravity &amp; Codex Live Activity feed (tools, commands, browser, subagents)"/>
            </Border>
            <Border Background="#080B13" BorderBrush="#243554" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18">
              <DockPanel>
                <Button Name="AfterUpdateFlashBtn" DockPanel.Dock="Right" Content="Flash StickS3 (USB)" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Name="AfterUpdateUsbTitle" FontSize="13" FontWeight="SemiBold" Text="StickS3 Firmware (v2.0.0)"/>
                  <TextBlock Name="AfterUpdateUsbHint" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="Plug in M5Stick S3 via USB-C to install the latest v2.0.0 firmware."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Button Name="AfterUpdateCloseBtn" Style="{StaticResource PrimaryBtn}" Content="Continue to AgentDeck" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
